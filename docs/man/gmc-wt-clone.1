.SH NAME
gmc-wt-clone - Clone a repo into bare + worktree layout


.SH SYNOPSIS
\fBgmc wt clone  [flags]\fP


.SH DESCRIPTION
Clone a repository into a .bare directory plus a worktree for the default branch.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for clone

.PP
\fB--name\fP=""
	Custom project directory name

.PP
\fB--upstream\fP=""
	Upstream repository URL (for fork workflow)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc wt clone https://github.com/user/repo.git
  gmc wt clone https://github.com/me/fork.git --upstream https://github.com/org/repo.git --name repo
.EE


