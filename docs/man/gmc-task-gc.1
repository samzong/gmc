.TH "GMC" "1" "Oct 2026" "gmc" "GMC Manual"

.SH NAME
gmc-task-gc - Show or apply task cleanup


.SH SYNOPSIS
\fBgmc task gc [flags]\fP


.SH DESCRIPTION
Show cleanup candidates for task tmux sessions and worktrees.
By default this is a dry run; only --apply executes "kill" actions.
Worktrees, branches, and task ledger files are never removed.


.SH OPTIONS
\fB--apply\fP[=false]
	Kill live sessions marked "kill" (not attached, node finished or task done)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for gc


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc task gc
  gmc task gc --apply
.EE


.SH SEE ALSO
\fBgmc-task(1)\fP


