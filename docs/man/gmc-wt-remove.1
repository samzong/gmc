.TH "GMC" "1" "Sep 2026" "gmc" "GMC Manual"

.SH NAME
gmc-wt-remove - Remove worktrees


.SH SYNOPSIS
\fBgmc wt remove [name...] [flags]\fP


.SH DESCRIPTION
Remove one or more worktrees. The branch is kept unless -D is given.


.SH OPTIONS
\fB-a\fP, \fB--all\fP[=false]
	Remove all non-protected worktrees

.PP
\fB-D\fP, \fB--delete-branch\fP[=false]
	Also delete the branch

.PP
\fB--dry-run\fP[=false]
	Preview what would be removed without making changes

.PP
\fB-f\fP, \fB--force\fP[=false]
	Force removal even if worktree is dirty

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for remove


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc wt remove feature-login
  gmc wt rm --all --dry-run
.EE


.SH SEE ALSO
\fBgmc-wt(1)\fP


