.TH "GMC" "1" "Sep 2026" "gmc" "GMC Manual"

.SH NAME
gmc-wt-promote - Apply a candidate back into the current worktree


.SH SYNOPSIS
\fBgmc wt promote  [flags]\fP


.SH DESCRIPTION
Apply a candidate's changes into the current parent worktree as uncommitted changes.
It never commits, pushes, opens PRs, or deletes the candidate.


.SH OPTIONS
\fB--dry-run\fP[=false]
	Check whether the candidate can be promoted without changing files

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for promote


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc wt promote .dup-2 --dry-run
  gmc wt promote .dup-2
.EE


.SH SEE ALSO
\fBgmc-wt(1)\fP


