.TH "GMC" "1" "Sep 2026" "gmc" "GMC Manual"

.SH NAME
gmc-wt-dup - Fan out worktrees for parallel AI agents


.SH SYNOPSIS
\fBgmc wt dup [count] [flags]\fP


.SH DESCRIPTION
Create N sibling worktrees on temporary branches (_dup//-) for parallel agents.
Defaults to 2 worktrees from the current branch. Promote the winner with 'gmc wt promote'.


.SH OPTIONS
\fB-b\fP, \fB--base\fP=""
	Base branch to create from

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for dup

.PP
\fB--task\fP=[]
	Task context file to copy into each candidate (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc wt dup
  gmc wt dup 3 -b main
  gmc wt dup 3 --task todo.md
.EE


.SH SEE ALSO
\fBgmc-wt(1)\fP


