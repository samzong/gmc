.nh
.TH "GMC" "1" "Sep 2026" "gmc" "GMC Manual"

.SH NAME
gmc - Parallel git worktrees and AI commit messages


.SH SYNOPSIS
\fBgmc [flags]\fP


.SH DESCRIPTION
gmc manages sibling git worktrees on a bare (.bare) clone so parallel AI coding agents each get an isolated working tree.
Run 'gmc' with no arguments to generate a Conventional Commits message from the staged diff and commit it.


.SH OPTIONS
\fB-a\fP, \fB--all\fP[=false]
	Stage all files, or only the given paths, before committing

.PP
\fB-b\fP, \fB--branch\fP=""
	Create and switch to a new branch with generated name

.PP
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB--dry-run\fP[=false]
	Generate message only, do not commit

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for gmc

.PP
\fB--issue\fP=""
	Optional issue number

.PP
\fB--no-signoff\fP[=false]
	Skip signing the commit (DCO signoff)

.PP
\fB--no-verify\fP[=false]
	Skip pre-commit hooks

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json

.PP
\fB-p\fP, \fB--prompt\fP=""
	Additional context or instructions for commit message generation

.PP
\fB--timeout\fP=30
	LLM request timeout in seconds

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Show detailed git command output

.PP
\fB-V\fP, \fB--version\fP[=false]
	version for gmc

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Automatically confirm the commit message


.SH EXAMPLE
.EX
  gmc -a -y
  gmc wt add feature-login
  gmc
.EE


