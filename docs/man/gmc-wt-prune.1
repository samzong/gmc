.TH "GMC" "1" "Sep 2026" "gmc" "GMC Manual"

.SH NAME
gmc-wt-prune - Remove worktrees whose branches are merged


.SH SYNOPSIS
\fBgmc wt prune [flags]\fP


.SH DESCRIPTION
By default the local branch is deleted along with the worktree.

.PP
With --branches, merged local branches that have no worktree are deleted too,
so long-lived clones stop accumulating stale branches.


.SH OPTIONS
\fB-b\fP, \fB--base\fP=""
	Base branch to check merge status against

.PP
\fB--branches\fP[=false]
	Also delete merged local branches that have no worktree

.PP
\fB--dry-run\fP[=false]
	Preview what would be removed without making changes

.PP
\fB-f\fP, \fB--force\fP[=false]
	Force removal even if worktree is dirty

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for prune

.PP
\fB--pr-aware\fP[=false]
	Check GitHub PR state before pruning (requires gh CLI)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	Config file (default: $XDG_CONFIG_HOME/gmc/config.yaml)

.PP
\fB--debug\fP[=false]
	Enable debug output

.PP
\fB-o\fP, \fB--output\fP="text"
	Output format: text or json


.SH EXAMPLE
.EX
  gmc wt prune --dry-run
  gmc wt prune --branches --pr-aware --dry-run
.EE


.SH SEE ALSO
\fBgmc-wt(1)\fP


